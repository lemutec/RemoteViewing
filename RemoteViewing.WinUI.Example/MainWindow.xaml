<Window
    x:Class="RemoteViewing.WinUI.Example.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vnc="using:RemoteViewing.WinUI"
    Title="RemoteViewing - Example VNC Client (WinUI)">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnConnect"
                        Width="110"
                        Click="BtnConnect_Click"
                        Content="Connect" />
                <TextBlock VerticalAlignment="Center" Text="Hostname:" />
                <TextBox x:Name="TxtHostname"
                         Width="200"
                         Text="127.0.0.1" />
                <TextBlock VerticalAlignment="Center" Text="Port:" />
                <TextBox x:Name="TxtPort"
                         Width="80"
                         Text="5900" />
                <TextBlock VerticalAlignment="Center" Text="Password:" />
                <PasswordBox x:Name="TxtPassword" Width="150" />
                <CheckBox x:Name="ChkShowFps"
                          Content="Show FPS"
                          Checked="ChkShowFps_Changed"
                          Unchecked="ChkShowFps_Changed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="8" Background="Black">
            <vnc:VncControl x:Name="Vnc"
                            AllowClipboardSharingFromServer="True"
                            AllowClipboardSharingToServer="True"
                            Closed="Vnc_Closed"
                            Connected="Vnc_Connected"
                            ConnectionFailed="Vnc_ConnectionFailed"
                            SizeMode="Zoom" />
        </Border>
    </Grid>
</Window>
