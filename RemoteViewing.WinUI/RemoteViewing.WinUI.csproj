<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0-windows10.0.19041.0;net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Each Windows SDK projection is built for one .NET generation. -->
    <WindowsSdkPackageVersion Condition="$(TargetFramework.StartsWith('net6.0'))">10.0.19041.55</WindowsSdkPackageVersion>
    <WindowsSdkPackageVersion Condition="$(TargetFramework.StartsWith('net8.0'))">10.0.26100.57</WindowsSdkPackageVersion>
    <WindowsSdkPackageVersion Condition="$(TargetFramework.StartsWith('net9.0')) or $(TargetFramework.StartsWith('net10.0'))">10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>RemoteViewing.WinUI</RootNamespace>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Win32Resource>Assets\DotCursor.res</Win32Resource>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;CA1416;CS1591</NoWarn>
    <PackageId>Lemutec.RemoteViewing.WinUI</PackageId>
    <Product>Lemutec.RemoteViewing.WinUI</Product>
    <AssemblyName>Lemutec.RemoteViewing.WinUI</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Version>$(VersionPrefix)1.2.1.0</Version>
    <Authors>James F. Bellinger, Lemutec</Authors>
    <Company>James F. Bellinger, Lemutec</Company>
    <Description>RemoteViewing is a .NET-native VNC client and server library. This package adds a WinUI 3 control so you can embed a VNC viewer in Windows App SDK applications.</Description>
    <PackageProjectUrl>https://github.com/lemutec/RemoteViewing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lemutec/RemoteViewing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp vnc-client vnc-server vnc rfb winui winui3 windowsappsdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath=""/>
    <None Include="..\logo.png" Pack="true" PackagePath=""/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteViewing\RemoteViewing.csproj" />
  </ItemGroup>

  <!--
    Rebuild cleans obj, then each target framework builds in parallel.
    An inner restore would overwrite project.assets.json with a single framework
    and the others fail with NETSDK1005. Restore every framework once, first.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <RestoreDuringBuild>false</RestoreDuringBuild>
  </PropertyGroup>

  <Target Name="RestoreAllFrameworksBeforeInnerBuilds"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(TargetFramework)' == ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Restore"
             RemoveProperties="TargetFramework" />
  </Target>
</Project>
